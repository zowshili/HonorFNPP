#!/usr/bin/env python3
"""HonorFNPP — HONOR MagicBook Fn+P performance mode sync.

The EC handles Fn+P and flips its TUBF bit (EC offset 0xDC bit 0) by itself.
A 45 W package limit needs BOTH:
  * EC TUBF = 1
  * ACPI platform_profile = performance (AMD PMF / power-profiles-daemon)

This daemon keeps those two in sync in both directions and shows a GNOME OSD.
Tested on HONOR MagicBook X 14 Pro (FRI-HXX, Ryzen 7 7840HS, BIOS 1.15).
"""

import argparse
import glob
import json
import logging
import os
import re
import shutil
import subprocess
import sys
import time

__version__ = "1.1.1"

def _config_path():
    env = os.environ.get("HONORFNPP_CONFIG") or os.environ.get("HONOR_PERFMODE_CONFIG")
    if env:
        return env
    new = "/etc/honorfnpp.conf"
    old = "/etc/honor-perfmode.conf"
    if os.path.exists(new) or not os.path.exists(old):
        return new
    return old


CONFIG_PATH = _config_path()

DEFAULT_CONFIG = {
    "DEVICE_PROFILE": "",
    "POLL_INTERVAL": "",
    "NOTIFY_APP": "HONOR",
    "OSD_BACKEND": "auto",
    "DESKTOP_OVERRIDE": "",
    # Advanced overrides. Normally empty; the selected device profile
    # provides these values.
    "EC_DEVICE": "",
    "EC_OFFSET": "",
    "WMAA_PATH": "",
    "WMAA_GROUP": "",
    "WMAA_GET_COMMAND": "",
    "WMAA_SET_COMMAND": "",
}


def load_config(path):
    cfg = dict(DEFAULT_CONFIG)
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                cfg[key.strip()] = value.strip()
    except OSError:
        pass
    return cfg


CONFIG = load_config(CONFIG_PATH)
OSD_BACKEND_CONFIG = (CONFIG.get("OSD_BACKEND") or "auto").strip().lower()
if OSD_BACKEND_CONFIG not in ("auto", "kde-osd", "notify-send", "kdialog", "dbus", "none"):
    OSD_BACKEND_CONFIG = "auto"
DESKTOP_OVERRIDE = (CONFIG.get("DESKTOP_OVERRIDE") or "").strip().lower()

PROFILE_SYSFS = "/sys/firmware/acpi/platform_profile"
ACPI_CALL = "/proc/acpi/call"

PERF = "performance"
BAL = "balanced"

log = logging.getLogger("honorfnpp")
_ec_ready = False


def run(cmd, timeout=15):
    try:
        return subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(cmd, 127, "", str(exc))


def dmi_value(name):
    try:
        with open(f"/sys/class/dmi/id/{name}") as fh:
            return fh.read().strip()
    except OSError:
        return "unknown"


GENERIC_PROFILE = {
    "id": "generic",
    "name": "Generic HONOR (legacy defaults)",
    "status": "unknown",
    "match": {},
    "ec": {"device": "/sys/kernel/debug/ec/ec0/io", "offset": "0xDC"},
    "acpi": {
        "wmaa_path": r"\_SB.WMI1.WMAA",
        "group": "0x04",
        "get_command": "0x0E",
        "set_command": "0x0F",
    },
    "defaults": {"poll_interval": 0.5, "notify_app": "HONOR"},
    "tested": {},
    "notes": "Built-in fallback; no matching device profile.",
    "_source": "builtin",
}


def _profile_dirs():
    env = os.environ.get("HONORFNPP_DEVICES") or os.environ.get("HONOR_PERFMODE_DEVICES")
    if env:
        try:
            path = os.path.abspath(os.path.expanduser(env))
        except (TypeError, ValueError):
            return []
        return [path] if os.path.isdir(path) else []
    dirs = []
    here = os.path.dirname(os.path.abspath(__file__))
    dirs.append(os.path.join(os.path.dirname(here), "devices"))
    dirs.append("/etc/honorfnpp/devices")
    dirs.append("/usr/local/share/honorfnpp/devices")
    # Compatibility with the pre-rename paths.
    dirs.append("/etc/honor-perfmode/devices")
    dirs.append("/usr/local/share/honor-perfmode/devices")
    seen = set()
    out = []
    for directory in dirs:
        try:
            path = os.path.abspath(os.path.expanduser(directory))
        except (TypeError, ValueError):
            continue
        if path not in seen and os.path.isdir(path):
            seen.add(path)
            out.append(path)
    return out


def _load_profile_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        log.warning("cannot load device profile %s: %s", path, exc)
        return None
    if not isinstance(data, dict):
        log.warning("device profile %s is not a JSON object", path)
        return None
    for key in ("id", "name", "match", "ec", "acpi"):
        if key not in data:
            log.warning("device profile %s is missing %s", path, key)
            return None
    data["_source"] = path
    return data


def load_profiles():
    profiles = []
    seen = set()
    for directory in _profile_dirs():
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".json") or name.startswith("_"):
                continue
            profile = _load_profile_file(os.path.join(directory, name))
            if not profile:
                continue
            pid = str(profile.get("id", ""))
            if pid in seen:
                continue
            seen.add(pid)
            profiles.append(profile)
    return profiles


def _match_score(profile, vendor, product, board, bios):
    match = profile.get("match")
    if not isinstance(match, dict):
        return -1
    vendor_match = str(match.get("dmi_vendor", "")).strip()
    product_match = str(match.get("dmi_product", "")).strip()
    if vendor_match and vendor_match.lower() != vendor.lower():
        return -1
    if product_match and product_match.lower() != product.lower():
        return -1
    board_match = str(match.get("dmi_board", "")).strip()
    if board_match and board_match.lower() != board.lower():
        return -1
    bios_match = match.get("dmi_bios")
    if bios_match:
        values = bios_match if isinstance(bios_match, list) else [bios_match]
        if bios not in [str(value) for value in values]:
            return -1
    score = 0
    if product_match:
        score += 8
    if vendor_match:
        score += 4
    if board_match:
        score += 2
    if bios_match:
        score += 1
    return score


def select_profile(setting):
    profiles = load_profiles()
    warning = None
    if setting:
        if os.path.isfile(setting):
            profile = _load_profile_file(setting)
            if profile:
                return profile, setting, None
            return GENERIC_PROFILE, "builtin", f"cannot load device profile {setting}"
        for profile in profiles:
            if profile.get("id") == setting:
                return profile, profile.get("_source", ""), None
        warning = f"device profile '{setting}' not found; auto-detecting"

    vendor = dmi_value("sys_vendor")
    product = dmi_value("product_name")
    board = dmi_value("board_name")
    bios = dmi_value("bios_version")
    best = None
    best_score = -1
    for profile in profiles:
        score = _match_score(profile, vendor, product, board, bios)
        if score > best_score:
            best, best_score = profile, score
    if best is not None and best_score >= 0:
        return best, best.get("_source", ""), warning

    message = (
        f"no device profile for DMI {vendor} / {product} (BIOS {bios}); "
        "using legacy defaults"
    )
    if warning:
        message = f"{warning}; {message}"
    return GENERIC_PROFILE, "builtin", message


def _hex_int(value, default):
    try:
        return int(str(value), 0)
    except (TypeError, ValueError):
        return default


DEVICE_SETTING = (
    os.environ.get("HONORFNPP_DEVICE_PROFILE", "").strip()
    or os.environ.get("HONOR_DEVICE_PROFILE", "").strip()
    or str(CONFIG.get("DEVICE_PROFILE", "")).strip()
)
PROFILE, PROFILE_SOURCE, PROFILE_WARNING = select_profile(DEVICE_SETTING)

_ec_section = PROFILE.get("ec") if isinstance(PROFILE.get("ec"), dict) else {}
_acpi_section = PROFILE.get("acpi") if isinstance(PROFILE.get("acpi"), dict) else {}
_defaults_section = PROFILE.get("defaults") if isinstance(PROFILE.get("defaults"), dict) else {}

EC_IO = str(
    CONFIG.get("EC_DEVICE")
    or _ec_section.get("device")
    or GENERIC_PROFILE["ec"]["device"]
)
EC_OFFSET = _hex_int(CONFIG.get("EC_OFFSET") or _ec_section.get("offset"), 0xDC) & 0xFF
WMAA = str(
    CONFIG.get("WMAA_PATH")
    or _acpi_section.get("wmaa_path")
    or GENERIC_PROFILE["acpi"]["wmaa_path"]
)
WMAA_GROUP = _hex_int(
    CONFIG.get("WMAA_GROUP") or _acpi_section.get("group"),
    int(GENERIC_PROFILE["acpi"]["group"], 0),
) & 0xFF
WMAA_GET = _hex_int(
    CONFIG.get("WMAA_GET_COMMAND") or _acpi_section.get("get_command"),
    int(GENERIC_PROFILE["acpi"]["get_command"], 0),
) & 0xFF
WMAA_SET = _hex_int(
    CONFIG.get("WMAA_SET_COMMAND") or _acpi_section.get("set_command"),
    int(GENERIC_PROFILE["acpi"]["set_command"], 0),
) & 0xFF
try:
    POLL_INTERVAL = float(
        CONFIG.get("POLL_INTERVAL") or _defaults_section.get("poll_interval") or 0.5
    )
except (TypeError, ValueError):
    POLL_INTERVAL = 0.5
POLL_INTERVAL = min(max(POLL_INTERVAL, 0.1), 10.0)
NOTIFY_APP = str(
    CONFIG.get("NOTIFY_APP") or _defaults_section.get("notify_app") or "HONOR"
)


def device_info():
    return {
        "id": PROFILE.get("id", "generic"),
        "name": PROFILE.get("name", ""),
        "status": PROFILE.get("status", "unknown"),
        "source": PROFILE_SOURCE,
        "match": PROFILE.get("match", {}),
        "warning": PROFILE_WARNING,
    }


def ensure_ec():
    global _ec_ready
    if _ec_ready or os.path.exists(EC_IO):
        _ec_ready = True
        return True
    run(["modprobe", "ec_sys"])
    time.sleep(0.2)
    _ec_ready = os.path.exists(EC_IO)
    return _ec_ready


def ec_read_byte():
    if not ensure_ec():
        raise FileNotFoundError(
            f"{EC_IO} not found (try: modprobe ec_sys; run as root)"
        )
    fd = os.open(EC_IO, os.O_RDONLY)
    try:
        # Read only the byte we need. Reading the whole 256-byte region issues
        # 256 EC transactions per poll and can starve the PS/2 keyboard.
        data = os.pread(fd, 1, EC_OFFSET)
    finally:
        os.close(fd)
    if len(data) < 1:
        raise IOError("short EC read")
    return data[0]


def tubf():
    """Current EC performance bit: 0=smart, 1=performance."""
    return ec_read_byte() & 1


def ensure_acpi_call():
    if os.path.exists(ACPI_CALL):
        return True
    run(["modprobe", "acpi_call"])
    return os.path.exists(ACPI_CALL)


def wmaa(payload):
    if len(payload) != 64:
        raise ValueError("payload must be 64 bytes")
    if not ensure_acpi_call():
        raise RuntimeError("acpi_call is not available (install acpi-call-dkms)")
    cmd = f"{WMAA} 0 1 b{payload.hex()}"
    with open(ACPI_CALL, "w") as fh:
        fh.write(cmd)
    with open(ACPI_CALL, "r") as fh:
        out = fh.read()
    # The result is a package of two buffers; the second is the data buffer.
    # /proc/acpi/call returns only the first 256 formatted bytes, so do not
    # require the second buffer's closing brace.
    sep = out.find("}, {")
    if sep < 0:
        raise RuntimeError(f"unexpected acpi_call output: {out[:160]!r}")
    vals = [int(x, 16) for x in re.findall(r"0x([0-9a-fA-F]{2})", out[sep + 3:])]
    if len(vals) < 2:
        raise RuntimeError(f"short acpi_call output: {out[:160]!r}")
    return bytes(vals)


def get_mode():
    """GTUB: read the EC performance bit via the profile's WMI values."""
    out = wmaa(bytes([WMAA_GROUP, WMAA_GET, 0x00]) + bytes(61))
    return out[1] if len(out) > 1 else -1


def set_mode(value):
    """STUB: write the EC performance bit via the profile's WMI values."""
    if value not in (0, 1):
        raise ValueError("mode must be 0 or 1")
    wmaa(bytes([WMAA_GROUP, WMAA_SET, value]) + bytes(61))
    time.sleep(0.1)
    return tubf()


def ppd_get():
    # platform_profile is the cheap, authoritative view of what PPD applied.
    # Avoid spawning powerprofilesctl (a Python program) twice a second.
    try:
        with open(PROFILE_SYSFS) as fh:
            value = fh.read().strip()
        if value:
            return value
    except OSError:
        pass
    res = run(["powerprofilesctl", "get"])
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    return "unknown"


def ppd_set(profile):
    res = run(["powerprofilesctl", "set", profile])
    if res.returncode == 0:
        return True
    try:
        with open(PROFILE_SYSFS, "w") as fh:
            fh.write(profile)
        return True
    except OSError as exc:
        log.warning("cannot set platform_profile=%s: %s", profile, exc)
        return False


def graphical_session():
    res = run(["loginctl", "list-sessions", "--no-legend"])
    if res.returncode != 0:
        return None
    for line in res.stdout.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        sid, uid_text, user = parts[0], parts[1], parts[2]
        try:
            uid = int(uid_text)
        except ValueError:
            continue
        show = run(["loginctl", "show-session", sid])
        if show.returncode != 0:
            continue
        props = {}
        for ln in show.stdout.splitlines():
            if "=" in ln:
                key, value = ln.split("=", 1)
                props[key] = value
        if props.get("Active") != "yes" or props.get("Remote") != "no":
            continue
        if props.get("Type") not in ("x11", "wayland"):
            continue
        return uid, user, (props.get("Display") or ":0")
    return None


def _session_env():
    sess = graphical_session()
    if not sess:
        return None
    uid, user, display = sess
    env = [
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
        f"XDG_RUNTIME_DIR=/run/user/{uid}",
    ]
    if display:
        env.append(f"DISPLAY={display}")
    return user, env


def process_running(name):
    res = run(["pgrep", "-x", name])
    if res.returncode in (0, 1):
        return res.returncode == 0
    # pgrep missing: fall back to /proc
    try:
        pids = os.listdir("/proc")
    except OSError:
        return False
    for pid in pids:
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/comm") as fh:
                if fh.read().strip() == name:
                    return True
        except OSError:
            continue
    return False


def detect_desktop():
    override = os.environ.get("HONOR_DESKTOP", "").strip().lower() or DESKTOP_OVERRIDE
    if override and override != "auto":
        if "kde" in override or "plasma" in override:
            return "kde"
        if "dde" in override or "deepin" in override:
            return "deepin"
        if "gnome" in override:
            return "gnome"
        return override

    # The daemon runs as root, so XDG_CURRENT_DESKTOP is not inherited.
    # Detect the running shell/compositor instead.
    if any(process_running(x) for x in ("plasmashell", "kwin_x11", "kwin_wayland")):
        return "kde"
    if any(process_running(x) for x in (
        "dde-desktop", "dde-dock", "dde-shell", "dde-session-daemon", "startdde",
        "treeland",
    )):
        return "deepin"
    if process_running("gnome-shell"):
        return "gnome"

    raw = (
        os.environ.get("XDG_CURRENT_DESKTOP", "") + ":" +
        os.environ.get("XDG_SESSION_DESKTOP", "")
    ).upper()
    if "KDE" in raw or "PLASMA" in raw:
        return "kde"
    if "DDE" in raw or "DEEPIN" in raw:
        return "deepin"
    if "GNOME" in raw:
        return "gnome"
    return "other"


def kde_qdbus():
    for name in ("qdbus6", "qdbus-qt6", "qdbus"):
        path = shutil.which(name)
        if path:
            return path
    return None


def osd_backend(desktop=None):
    if OSD_BACKEND_CONFIG != "auto":
        return OSD_BACKEND_CONFIG
    desktop = desktop or detect_desktop()
    if desktop == "kde" and (shutil.which("dbus-send") or kde_qdbus()):
        return "kde-osd"
    if shutil.which("notify-send"):
        return "notify-send"
    if shutil.which("kdialog"):
        return "kdialog"
    if shutil.which("dbus-send"):
        return "dbus"
    return "none"


def notify_kde_osd(title, body, icon, session_env):
    user, env = session_env
    text = f"{title} · {body}"
    # Prefer dbus-send: no Qt/qdbus installation or qtchooser default needed.
    if shutil.which("dbus-send"):
        res = run([
            "runuser", "-u", user, "--", "env", *env, "dbus-send",
            "--session", "--print-reply=literal", "--type=method_call",
            "--dest=org.kde.plasmashell", "/org/kde/osdService",
            "org.kde.osdService.showText",
            f"string:{icon}", f"string:{text}",
        ], timeout=5)
        if res.returncode == 0:
            return True
        log.info("kde-osd (dbus-send) failed: %s", res.stderr.strip())
    qdbus = kde_qdbus()
    if qdbus:
        res = run([
            "runuser", "-u", user, "--", "env", *env, qdbus,
            "org.kde.plasmashell", "/org/kde/osdService",
            "org.kde.osdService.showText", icon, text,
        ], timeout=5)
        if res.returncode == 0:
            return True
        log.info("kde-osd (qdbus) failed: %s", res.stderr.strip())
    return False


def notify_send(title, body, icon, session_env):
    if not shutil.which("notify-send"):
        return False
    user, env = session_env
    res = run([
        "runuser", "-u", user, "--", "env", *env,
        "notify-send", "-a", NOTIFY_APP, "-i", icon, "-t", "2500",
        "-h", "string:x-canonical-private-synchronous:honorfnpp",
        title, body,
    ], timeout=5)
    if res.returncode != 0:
        log.info("notify-send failed: %s", res.stderr.strip())
    return res.returncode == 0


def notify_kdialog(title, body, icon, session_env):
    if not shutil.which("kdialog"):
        return False
    user, env = session_env
    res = run([
        "runuser", "-u", user, "--", "env", *env,
        "kdialog", "--title", NOTIFY_APP, "--icon", icon,
        "--passivepopup", f"{title}\n{body}", "3",
    ], timeout=5)
    if res.returncode != 0:
        log.info("kdialog failed: %s", res.stderr.strip())
    return res.returncode == 0


def notify_dbus(title, body, icon, session_env):
    if not shutil.which("dbus-send"):
        return False
    user, env = session_env
    res = run([
        "runuser", "-u", user, "--", "env", *env, "dbus-send",
        "--session", "--print-reply=literal", "--type=method_call",
        "--dest=org.freedesktop.Notifications",
        "/org/freedesktop/Notifications",
        "org.freedesktop.Notifications.Notify",
        f"string:{NOTIFY_APP}", "uint32:0", f"string:{icon}",
        f"string:{title}", f"string:{body}",
        "array:string:", "dict:string:variant:", "int32:2500",
    ], timeout=5)
    if res.returncode != 0:
        log.info("dbus-send failed: %s", res.stderr.strip())
    return res.returncode == 0


def mode_icon(ec, desktop):
    if desktop == "gnome":
        return "power-profile-performance-symbolic" if ec else "power-profile-balanced-symbolic"
    # Freedesktop name; present in Breeze and Deepin icon themes.
    return "preferences-system-power-management"


def notify(title, body, icon=None, desktop=None):
    if icon is None:
        icon = "dialog-information"
    desktop = desktop or detect_desktop()
    backend = osd_backend(desktop)
    if backend == "none":
        log.info("OSD disabled (OSD_BACKEND=none)")
        return False
    session_env = _session_env()
    if session_env is None:
        log.info("no graphical session for notification")
        return False

    backends = {
        "kde-osd": notify_kde_osd,
        "notify-send": notify_send,
        "kdialog": notify_kdialog,
        "dbus": notify_dbus,
    }
    order = [backend] + [name for name in backends if name != backend]
    for name in order:
        func = backends.get(name)
        if func and func(title, body, icon, session_env):
            return True
    log.warning("all OSD backends failed (desktop=%s backend=%s)", desktop, backend)
    return False


def notify_mode(ec):
    desktop = detect_desktop()
    icon = mode_icon(ec, desktop)
    if ec:
        notify("高能模式", "45W 功耗上限已释放", icon, desktop)
    else:
        notify("智能模式", "35W 功耗上限", icon, desktop)


def ac_online():
    for path in glob.glob("/sys/class/power_supply/*/type"):
        try:
            if open(path).read().strip() != "Mains":
                continue
            online = os.path.join(os.path.dirname(path), "online")
            return open(online).read().strip() == "1"
        except OSError:
            continue
    return None


def battery_capacity():
    for path in glob.glob("/sys/class/power_supply/BAT*/capacity"):
        try:
            return int(open(path).read().strip())
        except (OSError, ValueError):
            continue
    return None


def daemon():
    if not ensure_ec():
        log.error("EC device %s is not available", EC_IO)
        return 1
    log.info("starting: profile=%s (%s) ec=%s ppd=%s poll=%.2fs config=%s",
             PROFILE.get("id", "generic"), PROFILE.get("status", "unknown"),
             tubf(), ppd_get(), POLL_INTERVAL, CONFIG_PATH)
    if PROFILE_WARNING:
        log.warning("%s", PROFILE_WARNING)
    try:
        ec = tubf()
        ppd = ppd_get()
        if ec == 1 and ppd != PERF:
            if ppd_set(PERF):
                ppd = PERF
        elif ec == 0 and ppd == PERF:
            actual = set_mode(1)
            if actual == 1:
                ec = 1
            else:
                ppd_set(BAL)
                ppd = BAL
                notify("高能模式开启失败", "请接通电源后重试", "dialog-warning")
        last_ec, last_ppd = ec, ppd
        log.info("initial state: ec=%s ppd=%s", last_ec, last_ppd)
    except Exception as exc:  # noqa: BLE001
        log.error("startup sync failed: %s", exc)
        last_ec, last_ppd = tubf(), ppd_get()

    while True:
        time.sleep(POLL_INTERVAL)
        try:
            ec = tubf()
            ppd = ppd_get()
        except Exception as exc:  # noqa: BLE001
            log.warning("state read failed: %s", exc)
            time.sleep(2)
            continue

        if ec != last_ec:
            target = PERF if ec else BAL
            if ppd != target:
                if ppd_set(target):
                    ppd = target
                else:
                    log.warning("PPD set %s failed", target)
            notify_mode(ec)
            log.info("hardware switch: ec=%s ppd=%s", ec, ppd)
            last_ec, last_ppd = ec, ppd
        elif ppd != last_ppd:
            target_ec = 1 if ppd == PERF else 0
            if target_ec != ec:
                try:
                    actual = set_mode(target_ec)
                except Exception as exc:  # noqa: BLE001
                    log.warning("STUB(%s) failed: %s", target_ec, exc)
                    actual = ec
                if actual != target_ec:
                    revert = PERF if ec else BAL
                    if ppd_set(revert):
                        ppd = revert
                    notify("切换失败", "接通电源后重试" if target_ec else "无法关闭高能模式",
                           "dialog-warning")
                    log.warning("OS switch failed; reverted ppd=%s ec=%s", ppd, ec)
                else:
                    ec = actual
                    notify_mode(ec)
                    log.info("OS switch: ec=%s ppd=%s", ec, ppd)
            last_ec, last_ppd = ec, ppd
    return 0


def cmd_status(as_json=False):
    try:
        ec = tubf()
    except Exception as exc:  # noqa: BLE001
        print(f"EC read failed: {exc}", file=sys.stderr)
        print("Run this command with sudo.", file=sys.stderr)
        return 1
    ppd = ppd_get()
    try:
        gtub = get_mode()
    except Exception as exc:  # noqa: BLE001
        gtub = f"unavailable ({exc})"
    desktop = detect_desktop()
    data = {
        "ec_tubf": ec,
        "mode": "performance" if ec else "smart",
        "acpi_gtub": gtub,
        "platform_profile": ppd,
        "ppd": run(["powerprofilesctl", "get"]).stdout.strip(),
        "ac_online": ac_online(),
        "battery_percent": battery_capacity(),
        "acpi_call": os.path.exists(ACPI_CALL),
        "ec_device": EC_IO,
        "ec_offset": hex(EC_OFFSET),
        "device": device_info(),
        "desktop": desktop,
        "osd_backend": osd_backend(desktop),
    }
    if as_json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    print(f"EC TUBF          : {data['ec_tubf']} ({data['mode']})")
    print(f"ACPI GTUB        : {data['acpi_gtub']}")
    print(f"platform_profile : {data['platform_profile']}")
    print(f"PPD              : {data['ppd']}")
    print(f"AC online        : {data['ac_online']}")
    print(f"Battery          : {data['battery_percent']}%")
    print(f"acpi_call        : {'yes' if data['acpi_call'] else 'no'}")
    print(f"EC device        : {data['ec_device']}")
    print(f"EC offset        : {data['ec_offset']}")
    print(f"Device profile   : {data['device']['id']} ({data['device']['status']})")
    print(f"Desktop          : {data['desktop']}")
    print(f"OSD backend      : {data['osd_backend']}")
    return 0


def cmd_check():
    vendor = dmi_value("sys_vendor")
    product = dmi_value("product_name")
    bios = dmi_value("bios_version")
    print("HONOR Fn+P mode checker")
    print(f"DMI vendor       : {vendor}")
    print(f"DMI product      : {product}")
    print(f"BIOS version     : {bios}")
    info = device_info()
    print(f"Device profile   : {info['id']} ({info['status']})")
    print(f"Profile name     : {info['name']}")
    print(f"Profile source   : {info['source']}")
    if info.get("warning"):
        print(f"Profile warning  : {info['warning']}")
    print(f"Config           : {CONFIG_PATH}")
    print(f"EC device        : {EC_IO}")
    print(f"EC offset        : {hex(EC_OFFSET)}")
    print(f"WMAA path        : {WMAA}")
    print(f"WMAA group/cmd   : {hex(WMAA_GROUP)} / get {hex(WMAA_GET)} / set {hex(WMAA_SET)}")
    print(f"Poll interval    : {POLL_INTERVAL:.2f}s")
    desktop = detect_desktop()
    print(f"Desktop          : {desktop}")
    print(f"OSD backend      : {osd_backend(desktop)}")
    if vendor.upper() not in ("HONOR", "HUAWEI"):
        print("WARNING          : DMI vendor is not HONOR/HUAWEI; this may not work.")
    ok = True
    if ensure_ec():
        try:
            ec = tubf()
            print(f"EC TUBF          : {ec} ({'performance' if ec else 'smart'})")
        except Exception as exc:  # noqa: BLE001
            print(f"EC read          : FAILED ({exc})")
            ok = False
    else:
        print("EC device        : NOT FOUND (modprobe ec_sys?)")
        ok = False
    print(f"acpi_call        : {'yes' if ensure_acpi_call() else 'no (install acpi-call-dkms)'}")
    try:
        print(f"ACPI GTUB        : {get_mode()}")
    except Exception as exc:  # noqa: BLE001
        print(f"ACPI GTUB        : FAILED ({exc})")
    try:
        with open(PROFILE_SYSFS) as fh:
            print(f"platform_profile : {fh.read().strip()}")
        with open(PROFILE_SYSFS + "_choices") as fh:
            print(f"profile choices  : {fh.read().strip()}")
    except OSError as exc:
        print(f"platform_profile : FAILED ({exc})")
    print(f"notify-send      : {'yes' if shutil.which('notify-send') else 'no'}")
    print(f"kdialog          : {'yes' if shutil.which('kdialog') else 'no'}")
    print(f"dbus-send        : {'yes' if shutil.which('dbus-send') else 'no'}")
    print(f"qdbus            : {kde_qdbus() or 'no'}")
    print(f"powerprofilesctl : {'yes' if shutil.which('powerprofilesctl') else 'no'}")
    return 0 if ok else 1


def cmd_notify_test():
    desktop = detect_desktop()
    backend = osd_backend(desktop)
    print(f"Desktop          : {desktop}")
    print(f"OSD backend      : {backend}")
    ok = notify("HONOR 性能模式", "通知通道测试", "dialog-information", desktop)
    print(f"result           : {'ok' if ok else 'failed'}")
    return 0 if ok else 1


def apply_mode(value):
    try:
        actual = set_mode(value)
    except Exception as exc:  # noqa: BLE001
        print(f"EC write failed: {exc}", file=sys.stderr)
        print("Is acpi_call available and are you root?", file=sys.stderr)
        return 1
    if actual != value:
        print("EC refused the mode change. Performance mode normally requires AC power.",
              file=sys.stderr)
        return 2
    profile = PERF if value else BAL
    if not ppd_set(profile):
        print(f"Warning: EC set, but platform_profile={profile} failed", file=sys.stderr)
    print(f"{'performance' if value else 'smart'} mode: EC TUBF={value}, platform_profile={profile}")
    return 0


def main():
    parser = argparse.ArgumentParser(
        prog="honorfnpp",
        description="HONOR MagicBook Fn+P performance mode sync",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("daemon", help="run the sync daemon")
    p_status = sub.add_parser("status", help="show EC / PPD / AC state")
    p_status.add_argument("--json", action="store_true", help="machine-readable output")
    sub.add_parser("check", help="diagnose EC / ACPI / PPD support")
    sub.add_parser("notify-test", help="send a test notification via the detected backend")
    sub.add_parser("on", help="enable performance mode (45W)")
    sub.add_parser("off", help="enable smart mode (35W)")
    sub.add_parser("toggle", help="toggle performance mode")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")

    if args.command == "daemon":
        return daemon()
    if args.command == "status":
        return cmd_status(args.json)
    if args.command == "check":
        return cmd_check()
    if args.command == "notify-test":
        return cmd_notify_test()
    if args.command == "on":
        return apply_mode(1)
    if args.command == "off":
        return apply_mode(0)
    if args.command == "toggle":
        try:
            value = 0 if tubf() else 1
        except Exception as exc:  # noqa: BLE001
            print(f"EC read failed: {exc}", file=sys.stderr)
            return 1
        return apply_mode(value)
    return 1


if __name__ == "__main__":
    sys.exit(main())
