# HonorFNPP — HONOR MagicBook Fn+P performance mode configuration.
#
# After editing, restart the service:
#   sudo systemctl restart honorfnpp

# Device profile. Leave empty to auto-detect from DMI (recommended).
# You can also force an ID (e.g. "fri-hxx") or an absolute path to a JSON
# profile for testing a new model:
#   DEVICE_PROFILE=/path/to/devices/my-model.json
DEVICE_PROFILE=

# Poll interval in seconds. 0.5 is responsive; increase to 1.0 or 2.0 if
# the EC is busy or the keyboard feels sluggish.
POLL_INTERVAL=0.5

# Application name shown in GNOME/KDE/Deepin notifications.
NOTIFY_APP=HONOR

# Notification / OSD backend:
#   auto        - KDE -> Plasma OSD, others -> freedesktop notification
#   kde-osd     - org.kde.plasmashell /org/kde/osdService showText
#   notify-send - libnotify / freedesktop notification (KDE, Deepin, GNOME)
#   kdialog     - KDE passive popup
#   dbus        - raw org.freedesktop.Notifications via dbus-send
#   none        - disable OSD
OSD_BACKEND=auto

# Force desktop detection for testing: kde, deepin, gnome, other.
# Empty = auto-detect from the running shell/compositor.
DESKTOP_OVERRIDE=

# ---------------------------------------------------------------------------
# Advanced hardware overrides
#
# Normally these are taken from the selected device profile
# (devices/*.json). Only uncomment them if you are porting a model and do not
# want to add a profile yet.
# ---------------------------------------------------------------------------
# EC_DEVICE=/sys/kernel/debug/ec/ec0/io
# EC_OFFSET=0xDC
# WMAA_PATH=\_SB.WMI1.WMAA
# WMAA_GROUP=0x04
# WMAA_GET_COMMAND=0x0E
# WMAA_SET_COMMAND=0x0F
