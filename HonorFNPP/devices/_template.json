{
  "id": "vendor-product",
  "name": "HONOR MagicBook <model> (<year>, <cpu>)",
  "status": "experimental",
  "match": {
    "dmi_vendor": "HONOR",
    "dmi_product": "XXXX-XX"
  },
  "ec": {
    "device": "/sys/kernel/debug/ec/ec0/io",
    "offset": "0xDC"
  },
  "acpi": {
    "wmaa_path": "\\_SB.WMI1.WMAA",
    "group": "0x04",
    "get_command": "0x0E",
    "set_command": "0x0F"
  },
  "defaults": {
    "poll_interval": 0.5,
    "notify_app": "HONOR"
  },
  "tested": {
    "bios": "",
    "distro": "",
    "kernel": "",
    "balanced_w": 0,
    "performance_w": 0,
    "desktop": []
  },
  "notes": ""
}
