[Unit]
Description=HonorFNPP — HONOR MagicBook Fn+P performance mode sync
Documentation=file:/usr/local/share/doc/honorfnpp/README.md
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/honorfnpp daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
Alias=honor-perfmode.service
